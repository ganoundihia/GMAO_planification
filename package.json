    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-rate-limit": "^8.7.1",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "pdf-lib": "^1.17.1",
