# ─────────────────────────────────────────────────────────────────────────────
#  SETRAM — GMAO Planification : variables d'environnement
#  Copier ce fichier en `.env` (jamais commité) et renseigner les valeurs.
#  En production : variables d'environnement de l'hébergeur (Render → Environment).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase : côté navigateur (publiques, exposées dans le bundle) ──────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<clé publishable / anon>

# ── Supabase : côté serveur API (SECRET — ne jamais préfixer par VITE_) ──────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<clé service_role : accès total, contourne la RLS>

# ── Fiches d'inspection (serveur API) ────────────────────────────────────────
# Dossier racine contenant les fiches .xlsx (ex. C:\Fiches ou /srv/fiches)
FICHES_ROOT=./fiches-test
VITE_FICHES_SERVER=http://localhost:3000

# ── Jours fériés (APIs externes, optionnelles) ───────────────────────────────
VITE_ABSTRACT_API_KEY=
VITE_CALENDARIFIC_API_KEY=

# ── Connexion Google (optionnelle) ───────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=

# ── Serveur API ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Origines autorisées par CORS, séparées par des virgules
# (défaut : http://localhost:5173,5174,3000,3001)
CORS_ORIGINS=http://localhost:5173
# Derrière un reverse-proxy / CDN : nombre de proxys de confiance (ex. 1) pour que
# le rate limiting voie la vraie IP du client. Laisser vide en accès direct.
TRUST_PROXY=

# ── Rate limiting (par IP et par fenêtre) ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=600      # toutes les routes /api
RATE_LIMIT_WRITE_MAX=60        # POST / PUT / PATCH / DELETE
RATE_LIMIT_SENSITIVE_MAX=10    # écritures sur /api/profiles, /api/import, /api/print-fiches
